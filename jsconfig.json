{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "strict": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "*.js",
    "public/*.js",
    "public/**/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
